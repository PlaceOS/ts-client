{
    "name": "@placeos/ts-client",
    "version": "0.0.0-development",
    "description": "Typed PlaceOS REST API client, generated from the PlaceOS OpenAPI document",
    "license": "MIT",
    "author": "Alex Sorafumo <alex@place.tech>",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/PlaceOS/ts-client.git"
    },
    "keywords": [
        "placeos",
        "browser",
        "api"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./compat": {
            "types": "./dist/compat/index.d.ts",
            "default": "./dist/compat/index.js"
        },
        "./staff": {
            "types": "./dist/staff.d.ts",
            "default": "./dist/staff.js"
        },
        "./mock": {
            "types": "./dist/mock/index.d.ts",
            "default": "./dist/mock/index.js"
        }
    },
    "bin": {
        "placeos-migrate": "./dist/migrate/cli.js"
    },
    "files": [
        "dist",
        "src",
        "oauth-resp.html"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20.3"
    },
    "publishConfig": {
        "provenance": true
    },
    "scripts": {
        "generate": "bun scripts/generate.ts",
        "generate:check": "bun scripts/generate.ts --check",
        "v1-map": "bun scripts/v1-map.ts",
        "v1-map:check": "bun scripts/v1-map.ts --check",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.cli.json",
        "test": "bun test",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json && tsc -p test/loose",
        "format": "prettier --write .",
        "docs": "deno doc --html --name=@placeos/ts-client --output=docs src/index.ts src/staff.ts src/compat/index.ts src/mock/index.ts",
        "prepack": "bun run build",
        "semantic-release": "semantic-release"
    },
    "devDependencies": {
        "@types/bun": "1.4.3",
        "placeos-ts-client-6": "npm:@placeos/ts-client@6.13.0",
        "prettier": "3.9.10",
        "semantic-release": "25.0.9",
        "typescript": "7.0.2",
        "typescript-5": "npm:typescript@5.8.3"
    },
    "release": {
        "branches": [
            "+([0-9])?(.{+([0-9]),x}).x",
            "master",
            {
                "name": "next",
                "prerelease": true
            }
        ]
    }
}
